rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function getMembership(userId, orgId) {
      return get(/databases/$(database)/documents/memberships/$(userId + '_' + orgId)).data;
    }
    
    function isMemberOf(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId));
    }

    function hasOrgRole(orgId, roles) {
      return isMemberOf(orgId) && getMembership(request.auth.uid, orgId).role in roles;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic test path
    match /test/connection {
      allow get: if true;
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'updatedAt']);
    }

    // -------------------------------------------------------------------------
    // ORGANIZATIONS
    // -------------------------------------------------------------------------
    function isValidOrg(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.type in ['supplier', 'retailer'] &&
             data.ownerId is string &&
             data.keys().hasAll(['name', 'type', 'ownerId']) &&
             data.keys().size() >= 3 && data.keys().size() <= 5; // Allow for createdAt/updatedAt
    }

    match /organizations/{orgId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(orgId) && isValidOrg(incoming());
      allow update: if hasOrgRole(orgId, ['supplier', 'retailer', 'owner']) && isValidOrg(incoming());
    }

    // -------------------------------------------------------------------------
    // MEMBERSHIPS
    // -------------------------------------------------------------------------
    function isValidMembership(data) {
      return data.userId is string &&
             data.organizationId is string &&
             data.role in ['owner', 'admin', 'employee', 'retailer', 'supplier'] &&
             data.status in ['active', 'inactive'];
    }

    match /memberships/{membershipId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isMemberOf(resource.data.organizationId));
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && hasOrgRole(existing().organizationId, ['owner', 'admin', 'supplier', 'retailer']);
      allow delete: if isSignedIn() && hasOrgRole(existing().organizationId, ['owner', 'admin', 'supplier', 'retailer']);
    }

    // -------------------------------------------------------------------------
    // PRODUCTS
    // -------------------------------------------------------------------------
    function isValidProduct(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.supplierId is string;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasOrgRole(incoming().supplierId, ['supplier', 'owner', 'admin']) && isValidProduct(incoming());
      allow update: if isSignedIn() && hasOrgRole(existing().supplierId, ['supplier', 'owner', 'admin']) && isValidProduct(incoming());
      allow delete: if isSignedIn() && hasOrgRole(existing().supplierId, ['supplier', 'owner', 'admin']);
    }

    // -------------------------------------------------------------------------
    // ORDERS
    // -------------------------------------------------------------------------
    function isValidOrder(data) {
      return data.supplierId is string &&
             data.retailerId is string &&
             data.totalAmount is number &&
             data.status in ['pending', 'assigned', 'out_for_delivery', 'delivered', 'cancelled'];
    }

    function isValidOrderUpdate(existingData, incomingData) {
      return (incomingData.status == null || incomingData.status in ['pending', 'assigned', 'out_for_delivery', 'delivered', 'cancelled']) &&
             (incomingData.payment_status == null || incomingData.payment_status in ['paid', 'unpaid', 'credit']) &&
             (incomingData.amount_collected == null || incomingData.amount_collected is number);
    }

    match /orders/{orderId} {
      // Optimize read for list queries to avoid hitting the 10-read limit (exists/get calls)
      // We allow list as long as the user is signed in, but maintain strict get for individual documents
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.retailerId == request.auth.uid || 
        resource.data.supplierId == request.auth.uid ||
        isMemberOf(resource.data.retailerId) || 
        isMemberOf(resource.data.supplierId)
      );
      
      allow create: if isSignedIn() && (
        incoming().retailerId == request.auth.uid || 
        isMemberOf(incoming().retailerId) ||
        hasOrgRole(incoming().supplierId, ['owner', 'admin', 'supplier'])
      ) && isValidOrder(incoming());
      
      allow update: if isSignedIn() && (
        // Retailer can cancel
        (isMemberOf(existing().retailerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled') ||
        
        // Supplier admin/owner can update everything
        (hasOrgRole(existing().supplierId, ['supplier', 'owner', 'admin'])) ||
        
        // Employee can update status and delivery info if assigned
        (hasOrgRole(existing().supplierId, ['employee']) && 
         existing().employeeId == request.auth.uid &&
         isValidOrderUpdate(existing(), incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'payment_status', 'amount_collected', 'delivered_at', 'updatedAt']))
      );

      allow delete: if isSignedIn() && hasOrgRole(existing().supplierId, ['owner', 'admin', 'supplier']);
    }

    // -------------------------------------------------------------------------
    // INVITES
    // -------------------------------------------------------------------------
    match /invites/{inviteId} {
      allow get: if true; 
      allow list: if isSignedIn() && isMemberOf(resource.data.organizationId);
      allow create: if isSignedIn() && hasOrgRole(incoming().organizationId, ['supplier', 'retailer', 'owner', 'admin']);
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedBy', 'updatedAt', 'acceptedAt'])) ||
        hasOrgRole(existing().organizationId, ['supplier', 'retailer', 'owner', 'admin'])
      );
      allow delete: if isSignedIn() && hasOrgRole(existing().organizationId, ['supplier', 'retailer', 'owner', 'admin']);
    }
  }
}
