rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getMembership(orgId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + "_" + orgId)).data;
    }

    function hasMembership(orgId) {
      return isSignedIn() && orgId != null && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + "_" + orgId));
    }

    function isRole(orgId, role) {
      return hasMembership(orgId) && getMembership(orgId).get('role', '') == role;
    }

    function isOrgAdmin(orgId) {
      return isRole(orgId, 'supplier') || isRole(orgId, 'admin') || (isSignedIn() && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Rules ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
    }

    // --- Organization Rules ---
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (hasMembership(orgId) || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOrgAdmin(orgId) || resource.data.ownerId == request.auth.uid);
    }

    // --- Membership Rules ---
    match /memberships/{membershipId} {
      function isValidMembership(data) {
        return data.userId is string && data.organizationId is string
          && data.role in ['supplier', 'employee', 'retailer', 'admin']
          && data.status in ['active', 'pending', 'inactive'];
      }
      
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // --- Invite Rules ---
    match /invites/{inviteId} {
      function isValidInvite(data) {
        return data.organizationId is string && data.email is string
          && data.token is string && data.status in ['pending', 'accepted', 'rejected']
          && (data.expiresAt is timestamp || data.expiresAt is string);
      }

      allow get: if true; // Public for validation by token
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Order Rules ---
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.organizationId is string && data.supplierId is string
          && data.retailerId is string && data.status in ['pending', 'assigned', 'out_for_delivery', 'delivered']
          && data.totalAmount is number
          && (data.get('payment_status', 'unpaid') in ['paid', 'unpaid', 'credit'])
          && (data.get('amount_collected', 0) is number);
      }

      function canAccessOrder(data) {
        return hasMembership(data.organizationId) && (
          isRole(data.organizationId, 'supplier') ||
          (isRole(data.organizationId, 'retailer') && data.retailerId == request.auth.uid) ||
          (isRole(data.organizationId, 'employee') && data.employeeId == request.auth.uid)
        );
      }

      allow get: if isSignedIn() && canAccessOrder(resource.data);
      allow list: if isSignedIn() && (
        hasMembership(resource.data.organizationId) && (
          isOrgAdmin(resource.data.organizationId) ||
          (resource.data.retailerId == request.auth.uid) ||
          (resource.data.employeeId == request.auth.uid)
        )
      );
      allow create: if isSignedIn() && isOrgAdmin(incoming().organizationId) && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        (isOrgAdmin(existing().organizationId) && isValidOrder(incoming())) ||
        (isRole(existing().organizationId, 'employee') && existing().employeeId == request.auth.uid 
         && isValidOrder(incoming())
         && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'delivered_at', 'payment_status', 'amount_collected', 'updatedAt', 'notes']))
      );
    }
  }
}
