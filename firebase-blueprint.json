{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with basic information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "name": { "type": "string", "description": "Full name of the user." },
        "email": { "type": "string", "format": "email", "description": "Email address of the user." },
        "currency": { "type": "string", "description": "User preferred display currency." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["uid", "name", "email"]
    },
    "Organization": {
      "title": "Organization",
      "description": "A supplier or retailer organization.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the organization." },
        "type": { "type": "string", "enum": ["supplier", "retailer"], "description": "Type of organization." },
        "ownerId": { "type": "string", "description": "UID of the owner user." },
        "currency": { "type": "string", "description": "Default currency for the organization." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["name", "type", "ownerId"]
    },
    "Product": {
      "title": "Product",
      "description": "A product offered by a supplier.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the product." },
        "description": { "type": "string", "description": "Description of the product." },
        "price": { "type": "number", "description": "Unit price." },
        "currency": { "type": "string", "description": "Currency code (e.g., USD)." },
        "imageUrl": { "type": "string", "description": "URL of the product image." },
        "stock": { "type": "number", "description": "Current stock levels in inventory." },
        "unitCost": { "type": "number", "description": "Manufacturing or acquisition unit cost." },
        "restockHistory": {
          "type": "array",
          "description": "Historic ledger of restock batches.",
          "items": {
            "type": "object",
            "properties": {
              "quantityAdded": { "type": "number" },
              "unitCost": { "type": "number" },
              "totalCost": { "type": "number" },
              "date": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "supplierId": { "type": "string", "description": "ID of the supplier organization." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["name", "price", "currency", "supplierId"]
    },
    "Membership": {
      "title": "Membership",
      "description": "Links a user to an organization with a specific role.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user." },
        "organizationId": { "type": "string", "description": "ID of the organization." },
        "role": { "type": "string", "enum": ["owner", "admin", "employee", "retailer"], "description": "Role within the organization." },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "Membership status." }
      },
      "required": ["userId", "organizationId", "role", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a retailer to a supplier.",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string", "description": "ID of the supplier organization." },
        "supplierName": { "type": "string", "description": "Name of the supplier organization." },
        "retailerId": { "type": "string", "description": "ID of the retailer organization (or user UID)." },
        "retailerName": { "type": "string", "description": "Name of the retailer organization." },
        "employeeId": { "type": "string", "description": "ID of the employee assigned to the order." },
        "employeeName": { "type": "string", "description": "Name of the employee assigned to the order." },
        "totalAmount": { "type": "number", "description": "Total order amount." },
        "currency": { "type": "string", "description": "Currency code." },
        "deliveryDate": { "type": "string", "format": "date", "description": "Scheduled delivery date." },
        "status": { "type": "string", "enum": ["pending", "assigned", "out_for_delivery", "delivered", "cancelled"], "description": "Order status." },
        "payment_status": { "type": "string", "enum": ["unpaid", "paid", "credit"], "description": "Payment status." },
        "amount_collected": { "type": "number", "description": "Amount collected upon delivery." },
        "delivered_at": { "type": "string", "description": "Timestamp of delivery." },
        "items": { 
          "type": "array", 
          "description": "List of ordered items.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["supplierId", "retailerId", "totalAmount", "status"]
    },
    "Invite": {
      "title": "Invite",
      "description": "An invitation to join an organization.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Recipient email." },
        "role": { "type": "string", "enum": ["employee", "retailer"], "description": "Role to be assigned." },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"], "description": "Invite status." },
        "organizationId": { "type": "string", "description": "ID of the organization." },
        "organizationName": { "type": "string", "description": "Name of the organization." },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Expiration timestamp." }
      },
      "required": ["email", "role", "status", "organizationId"]
    },
    "Task": {
      "title": "Task",
      "description": "An administrative or prep task created by a supplier and assigned to an employee.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the task." },
        "description": { "type": "string", "description": "Details of the task." },
        "supplierId": { "type": "string", "description": "ID of the supplier organization." },
        "employeeId": { "type": "string", "description": "UID of the employee assigned to the task." },
        "employeeName": { "type": "string", "description": "Name of the assigned employee." },
        "status": { "type": "string", "enum": ["assigned", "accepted", "in_progress", "purchased", "awaiting_approval", "approved", "stock_added", "completed", "verified"], "description": "Task status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["title", "description", "supplierId", "employeeId", "status"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "A supplier-aligned external vendor definition.",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string", "description": "ID of the supplier organization." },
        "vendorName": { "type": "string", "description": "Name of the vendor." },
        "phone": { "type": "string", "description": "Vendor contact number." },
        "address": { "type": "string", "description": "Vendor physical address." },
        "notes": { "type": "string", "description": "Internal vendor notes." },
        "productIds": {
          "type": "array",
          "description": "List of product IDs supplied by this vendor.",
          "items": { "type": "string" }
        },
        "status": { "type": "string", "enum": ["active", "archived"], "description": "Vendor status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["supplierId", "vendorName", "status"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Chronological stock movement transactions tracker.",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string", "description": "Supplier organization ID." },
        "productId": { "type": "string", "description": "ID of the product involved." },
        "productName": { "type": "string", "description": "Name of the product." },
        "movementType": { "type": "string", "enum": ["procurement", "order", "adjustment", "correction", "transfer"] },
        "quantity": { "type": "number", "description": "The transfer/movement stock quantity." },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "sourceType": { "type": "string", "enum": ["vendor", "retailer", "manual", "system", "warehouse"] },
        "sourceId": { "type": "string" },
        "sourceName": { "type": "string" },
        "referenceId": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" },
        "performedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["organizationId", "productId", "productName", "movementType", "quantity", "direction", "sourceType", "performedBy"]
    },
    "VendorPaymentLedger": {
      "title": "VendorPaymentLedger",
      "description": "Chronological vendor liability and settlement payments log book.",
      "type": "object",
      "properties": {
        "organizationId": { "type": "string", "description": "Supplier organization ID." },
        "vendorId": { "type": "string", "description": "ID of the target vendor." },
        "vendorName": { "type": "string", "description": "Name of the target vendor." },
        "transactionType": { "type": "string", "enum": ["Procurement Credit", "Vendor Payment", "Adjustment", "Refund", "Write-off"] },
        "amount": { "type": "number", "description": "The transaction cash value." },
        "status": { "type": "string", "enum": ["Outstanding", "Partially Settled", "Settled", "Completed"] },
        "remainingAmount": { "type": "number", "description": "For credit entries, remaining layout due." },
        "referenceType": { "type": "string", "enum": ["procurement", "payment", "adjustment"] },
        "referenceId": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string", "description": "Name or identity of the person recording this." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["organizationId", "vendorId", "vendorName", "transactionType", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Supplier and retailer organizations."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Supplier product catalogs."
    },
    "/memberships/{membershipId}": {
      "schema": "Membership",
      "description": "User-organization relationships."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Retail orders."
    },
    "/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Invitations to join organizations."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Internal non-delivery operational chores."
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Sourced external vendors."
    },
    "/inventory_movements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Chronological product stock movement ledger entries."
    },
    "/vendor_payment_ledger/{ledgerId}": {
      "schema": "VendorPaymentLedger",
      "description": "Registry of vendor liability records and payments."
    }
  }
}
